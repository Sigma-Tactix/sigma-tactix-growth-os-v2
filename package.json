{
  "name": "sigma-tactix-growth-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "setup:google-ads-mcp": "pipx install google-ads-mcp==0.0.4",
    "opusmax:setup": "opusmax setup",
    "opusmax:status": "opusmax status --verify",
    "opusmax:test": "opusmax test",
    "opusmax:models": "opusmax models",
    "opusmax:doctor": "opusmax doctor",
    "setup:laya": "pip install \"laya[serve]\"",
    "laya:serve": "tsx scripts/startLaya.ts",
    "laya:decide": "tsx scripts/layaDecide.ts",
    "inventory:security": "node scripts/generateSecurityInventory.mjs",
    "verify:safety": "node scripts/verifyCommitSafety.mjs",
    "agents:docs": "node scripts/generateAgentDocs.mjs",
    "skills:search": "node scripts/skillsManager.mjs search",
    "skills:list": "node scripts/skillsManager.mjs list",
    "skills:restore": "node scripts/skillsManager.mjs restore",
    "skills:archive": "node scripts/skillsManager.mjs archive"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@google/genai": "^2.31.0",
    "@mcp-use/client": "2.4.5",
    "@modelcontextprotocol/server": "2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "border-beam": "^1.4.1",
    "bot-avatars": "^0.2.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "10.6.2",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.5.2",
    "hyperframes": "^0.8.208",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "opusmax-gateway": "^1.0.2",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "proxy-addr": "^2.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "voice-glow": "^0.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.2",
    "docx": "^9.15.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
