# ==============================================================================
# SigmaTactix Growth OS — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your `.env` file to version control.
# ==============================================================================

# --- AI / LLM Configuration ---
# Google Gemini API key for autonomous agent reasoning, content generation, and vision tasks.
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"

# Google Cloud API key (for Google Search Console, YouTube, or Google APIs integration)
GOOGLE_API_KEY="your-google-api-key-here"

# --- Database & Authentication (Supabase) ---
# Project URL from Supabase dashboard (Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Key (safe for browser client-side usage)
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Supabase Service Role Key (Server-only elevated privileges, e.g. for Stripe webhooks)
# CAUTION: Never expose this to the client/browser bundle.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# --- Payments & Subscriptions (Stripe) ---
# Stripe Secret API Key (begins with sk_live_... or sk_test_...)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Stripe Webhook Signing Secret (begins with whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# --- Credential Encryption ---
# 32-byte hexadecimal string or strong encryption passphrase used for AES-256-GCM
# encryption of connector and platform credentials in the Second Brain Vault.
CONNECTOR_CREDENTIALS_KEY="your-32-byte-hex-encryption-key-here"

# --- Application Hosting ---
# The public base URL of the deployed application (or http://localhost:3000 for local dev).
APP_URL="http://localhost:3000"

# --- Workspace & Multi-tenancy ---
# Default or initial workspace ID for the growth engine
MASTRA_SPIKE_WORKSPACE_ID="default-workspace-uuid"
