# ==============================================================================
# SigmaTactix Growth OS — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your `.env` file to version control.
# ==============================================================================

# --- AI / LLM Configuration ---
# Google Gemini API key for autonomous agent reasoning, content generation, and vision tasks.
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Laya System 1 decision runtime (https://github.com/NandhaKishorM/laya)
# Start locally with: LAYA_PRELOAD=0 laya-serve
# Shadow is the safe default: Laya scores decisions while deterministic policy remains authoritative.
LAYA_BASE_URL="http://127.0.0.1:8000"
LAYA_API_KEY=""
LAYA_MODEL="auto"
LAYA_MODE="shadow"
LAYA_CALIBRATED="false"
LAYA_TIMEOUT_MS="8000"

# TinyFish server-side web intelligence. Search and Fetch remain disabled until a key is supplied and verified.
TINYFISH_API_KEY=""
TINYFISH_TIMEOUT_MS="15000"

# MiroFish must remain behind a Sigma-controlled private gateway.
MIROFISH_BASE_URL=""
MIROFISH_SERVICE_TOKEN=""
MIROFISH_LICENSING_APPROVED="false"

# Google Cloud API key (for Google Search Console, YouTube, or Google APIs integration)
GOOGLE_API_KEY="your-google-api-key-here"

# --- Official Google Ads MCP (read-only reporting) ---
# Install the pinned runtime with: npm run setup:google-ads-mcp
# Enable the Google Ads API in GOOGLE_PROJECT_ID before attempting verification.
GOOGLE_PROJECT_ID="your-google-cloud-project-id"
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Absolute path to a server-side Google Application Default Credentials JSON file.
# Do not place the JSON file inside the repository.
GOOGLE_APPLICATION_CREDENTIALS=""
# Required only when access is routed through a Google Ads manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# OAuth-proxy alternative for a separately hosted Streamable HTTP MCP runtime.
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=""
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=""

# --- Database & Authentication (Supabase) ---
# Project URL from Supabase dashboard (Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Key (safe for browser client-side usage)
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Supabase Service Role Key (Server-only elevated privileges, e.g. for Stripe webhooks)
# CAUTION: Never expose this to the client/browser bundle.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# --- Payments & Subscriptions (Stripe) ---
# Stripe Secret API Key (begins with sk_live_... or sk_test_...)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Stripe Webhook Signing Secret (begins with whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# --- Credential Encryption ---
# 32-byte hexadecimal string or strong encryption passphrase used for AES-256-GCM
# encryption of connector and platform credentials in the Second Brain Vault.
CONNECTOR_CREDENTIALS_KEY="your-32-byte-hex-encryption-key-here"

# --- Application Hosting ---
# The public base URL of the deployed application (or http://localhost:3000 for local dev).
APP_URL="http://localhost:3000"

# Release gate for the VANTA Living System. Keep false until migration 0015,
# provider verification, and visual acceptance have passed in the target environment.
VITE_VANTA_ENABLED="false"

# --- Workspace & Multi-tenancy ---
# Default or initial workspace ID for the growth engine
MASTRA_SPIKE_WORKSPACE_ID="default-workspace-uuid"
