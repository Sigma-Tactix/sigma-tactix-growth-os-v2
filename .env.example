# ==============================================================================
# SigmaTactix Growth OS — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your `.env` file to version control.
# ==============================================================================

# --- AI / LLM Configuration ---
# Google Gemini API key for autonomous agent reasoning, content generation, and vision tasks.
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Creative Studio local runtimes. Ollama and LM Studio enhance prompts; ComfyUI renders pixels.
# All three are restricted to loopback addresses by the server adapters.
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
COMFYUI_BASE_URL="http://127.0.0.1:8188"
# Optional. When omitted, Growth OS discovers the first installed ComfyUI checkpoint.
# COMFYUI_CHECKPOINT="your-checkpoint.safetensors"

# OpusMax gateway — Claude-family LLM gateway (npm: opusmax-gateway, installed in this app)
# Run the setup wizard locally to obtain/verify your sk-ant-ox-... key:
#   npx opusmax-gateway setup        (or `npm run opusmax:setup`)
#   npx opusmax-gateway status --verify / test / models / doctor
# Two gateway hosts expose the same models (Admin > AI Model Config can point
# either one in the per-workspace base URL):
#   OpenAI-compatible:  https://api.opusmax.pro            (Bearer, /v1/chat/completions, /v1/models)
#   Anthropic-compatible: https://opusxmax.vercel.app/api  (x-api-key, /v1/messages, /v1/models)
# Key status check (used by the "Verify OpusMax Key" button): {base}/key-status?key=YOUR_KEY
# Appending [1m] to a model id requests the 1M context budget (gateway strips it).
OPUSMAX_API_KEY=""
OPUSMAX_BASE_URL="https://api.opusmax.pro"
# OpenAI account login (ChatGPT / Codex). Primary credential is the
# account sign-in token (admin-configured in Admin Command Center); the
# raw OPENAI_API_KEY above stays an optional fallback for automation.
OPENAI_ACCOUNT_TOKEN=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Laya System 1 decision runtime (https://github.com/NandhaKishorM/laya)
# Start locally with: npm run laya:serve. The script refuses to start without
# an API key and binds the service to loopback only.
# Shadow is the safe default: Laya scores decisions while deterministic policy remains authoritative.
LAYA_BASE_URL="http://127.0.0.1:8000"
LAYA_API_KEY="replace-with-a-random-server-only-token"
LAYA_MODEL="auto"
LAYA_MODE="shadow"
LAYA_CALIBRATED="false"
LAYA_TIMEOUT_MS="750"

# TinyFish server-side web intelligence. Search and Fetch remain disabled until a key is supplied and verified.
TINYFISH_API_KEY=""
TINYFISH_TIMEOUT_MS="15000"

# MiroFish must remain behind a Sigma-controlled private gateway.
MIROFISH_BASE_URL=""
MIROFISH_SERVICE_TOKEN=""
MIROFISH_LICENSING_APPROVED="false"

# Google Cloud API key (for Google Search Console, YouTube, or Google APIs integration)
GOOGLE_API_KEY="your-google-api-key-here"

# --- Google Search Console (SEO & AEO Authority module) ---
# OAuth 2.0 Web client used for the read-only Search Console grant
# (scope: https://www.googleapis.com/auth/webmasters.readonly).
# Canonical public origin for the OAuth round-trip. The server mints the
# redirect URI from the FIRST of these env vars that is set (APP_URL wins),
# falling back to the request origin in dev. Whichever value wins MUST be
# whitelisted VERBATIM in Google Cloud or Google answers Error 400
# redirect_uri_mismatch — the Connect dialog displays the exact URI with a
# copy button, and GET /api/gsc/diagnostics reports it for debugging.
APP_URL="http://localhost:3000"
# 1. Google Cloud Console -> APIs & Services -> Enable "Google Search Console API"
# 2. Create an OAuth 2.0 Client ID (Web application) and add the redirect URI:
#      ${APP_URL}/api/gsc/callback     (e.g. http://localhost:3000/api/gsc/callback)
#    The URI must match byte-for-byte: scheme + host + port + /api/gsc/callback.
#    A second (production) URI can be added alongside the local one.
# 3. Set the pair below. Workspace admins can instead paste a Client ID/Secret
#    directly in the Connect GSC dialog; that pair is stored AES-256-GCM
#    encrypted in the workspace vault and takes precedence over these env vars.
# 4. If Google shows "App not verified", the OAuth consent screen is still in
#    Testing mode: add your Google account under APIs & Services -> OAuth
#    consent screen -> Test users (no verification needed for personal use).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Official Google Ads MCP (read-only reporting) ---
# Install the pinned runtime with: npm run setup:google-ads-mcp
# Enable the Google Ads API in GOOGLE_PROJECT_ID before attempting verification.
GOOGLE_PROJECT_ID="your-google-cloud-project-id"
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Absolute path to a server-side Google Application Default Credentials JSON file.
# Do not place the JSON file inside the repository.
GOOGLE_APPLICATION_CREDENTIALS=""
# Required only when access is routed through a Google Ads manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# OAuth-proxy alternative for a separately hosted Streamable HTTP MCP runtime.
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=""
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=""

# --- Growth OS MCP gateway (server-only) ---
# TODO: Bind the process Google credentials to ONE actual workspace UUID.
MCP_GOOGLE_ADS_WORKSPACE_ID=""
# TODO: Explicit customer IDs this workspace may report on, comma-separated, no hyphens.
MCP_GOOGLE_ADS_CUSTOMER_IDS=""
# Enable only after authenticated local verification; this does not deploy a backend.
GROWTH_OS_MCP_ENABLED="false"
# Browser clients require exact allowed Origin values. Native clients may omit Origin.
GROWTH_OS_MCP_ALLOWED_ORIGINS=""
MCP_USE_ANONYMIZED_TELEMETRY="false"

# --- Database & Authentication (Supabase) ---
# Project URL from Supabase dashboard (Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Key (safe for browser client-side usage)
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Supabase Service Role Key (Server-only elevated privileges, e.g. for Stripe webhooks)
# CAUTION: Never expose this to the client/browser bundle.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# --- Payments & Subscriptions (Stripe) ---
# Stripe Secret API Key (begins with sk_live_... or sk_test_...)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Stripe Webhook Signing Secret (begins with whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# --- Credential Encryption ---
# 32-byte hexadecimal string or strong encryption passphrase used for AES-256-GCM
# encryption of connector and platform credentials in the Second Brain Vault.
CONNECTOR_CREDENTIALS_KEY="your-32-byte-hex-encryption-key-here"

# --- Application Hosting ---
# The public base URL of the deployed application (or http://localhost:3000 for local dev).
APP_URL="http://localhost:3000"

# Release gate for the VANTA Living System. Keep false until migration 0015,
# provider verification, and visual acceptance have passed in the target environment.
VITE_VANTA_ENABLED="false"

# --- Workspace & Multi-tenancy ---
# Default or initial workspace ID for the growth engine
MASTRA_SPIKE_WORKSPACE_ID="default-workspace-uuid"

# --- Demo fixtures (Phase 0) ---
# NEVER set true on an environment a real client logs into. A fresh tenant must
# start from an empty workspace; seeded rows that read as real work (completed
# deliveries, last-run times, follower counts) are fabricated claims.
# SEED_DEMO_WORKSPACE seeds the server-side workspace blob;
# VITE_SEED_DEMO_WORKSPACE seeds the client-side fixtures (e.g. Scheduler).
SEED_DEMO_WORKSPACE="false"
VITE_SEED_DEMO_WORKSPACE="false"

# --- Execution ledger (Phase 1) ---
# Make the transactional ledger the authoritative record for agent task
# identity and status. Leave false until migration 0017 is applied AND
# POST /api/workspace/execution-ledger/backfill reports unmatched: 0.
# workspace_state.agentTasks remains the store for the generated artifact body.
EXECUTION_LEDGER_AUTHORITATIVE="false"
