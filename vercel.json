{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "env": {
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
    "PUPPETEER_SKIP_DOWNLOAD": "1",
    "PLAYWRIGHT_SKIP_BROWSER_INSTALL": "1"
  },
  "functions": {
    "api/gateway.ts": {
      "maxDuration": 300,
      "includeFiles": "backend/agent-skills/**"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/gateway" },
    { "source": "/api/:path*", "destination": "/api/gateway" },
    { "source": "/healthz", "destination": "/api/gateway" },
    { "source": "/readyz", "destination": "/api/gateway" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
