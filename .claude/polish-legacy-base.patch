+    agentRole: 'Sovereign Multi-Touch Attribution Engine',
+    timestamp: 'Just now',
+    status: hasData ? 'SUCCESS' : 'PARTIAL',
+    moduleOrigin: 'Attribution & Marketing ROI Command',
+    inputSummary: `Recalculated with model: ${modelLabel}`,
+    outputSummary: hasData
